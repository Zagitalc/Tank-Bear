# /etc/tankbear/tankbear.env  (owner root, group tankbear, mode 0640). Never commit this file filled in.
# The public hostname belongs in /etc/caddy/tankbear.env, separate from these secrets.

# API
DATABASE_PATH=/var/lib/tankbear/tankbear.sqlite
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=1
# Comma-separated app keys, each at least 24 random characters. Generate one with: openssl rand -base64 33
API_KEYS=
ROUTING_BASE_URL=http://127.0.0.1:8002
# Label for the road graph, for example gb-2026-10-06 (the date of the OpenStreetMap extract).
ROUTING_GRAPH_VERSION=

# Fuel Finder (refresh job only)
FUEL_FINDER_CLIENT_ID=
FUEL_FINDER_CLIENT_SECRET=
